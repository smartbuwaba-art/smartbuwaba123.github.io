<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#38ff5b</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#020b05</item>
        <item name="android:navigationBarColor">#020b05</item>
        <item name="android:windowSplashScreenBackground">#020b05</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/app_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">700</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#020b05</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
